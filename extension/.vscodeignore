# Everything the extension needs at runtime is `out/`, `payload/` and
# `launcher/`. The rest is build input and would only make a 130MB artifact
# larger.
.vscode/**
src/**
node_modules/**
tsconfig.json
out/**/*.map
**/.DS_Store

# Cartograph Local, staged in by scripts/build-vsix.sh. vsce drops *.vsix by
# default, and this one is meant to ride along.
!companion/cartograph-local.vsix
