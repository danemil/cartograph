{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "out",
    "rootDir": "src",
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "typeRoots": ["../extension/node_modules/@types"],
    "types": ["node", "vscode"]
  },
  "include": ["src"]
}
