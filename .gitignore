# Build artifacts — the engine binary is NEVER committed (see PROVENANCE.md).
# It ships as a .vsix asset and a Release asset.
dist/
build/
*.vsix
*.pyc
__pycache__/
node_modules/
.venv/
venv/
*.egg-info/

# Staged into extension/ by scripts/build-vsix.sh so vsce can see them, and
# removed again on exit. Both are copies of build artifacts; neither is source.
extension/out/
extension/payload/
extension/launcher/

# Local data
*.db
*.db-shm
*.db-wal
.cartograph/

# OS
.DS_Store

# Graph data directories
.code-review-graph/
