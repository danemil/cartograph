{
  "name": "engine",
  "command": [
    ".venv/bin/python",
    "-m",
    "code_review_graph"
  ],
  "cwd": "engine",
  "operations": {
    "status": {
      "args": [
        "status",
        "--repo",
        "."
      ],
      "expect": "ok"
    },
    "status-no-graph": {
      "args": [
        "status",
        "--repo",
        "{tmpdir}"
      ],
      "expect": "precondition"
    },
    "query-hit": {
      "args": [
        "query",
        "callers_of",
        "attach_context_savings",
        "--repo",
        ".",
        "--limit",
        "3"
      ],
      "expect": "ok"
    },
    "query-miss": {
      "args": [
        "query",
        "callers_of",
        "definitely_not_a_real_symbol_xyz",
        "--repo",
        "."
      ],
      "expect": "ok"
    },
    "query-new-pattern": {
      "args": [
        "query",
        "references_to",
        "GraphStore",
        "--repo",
        ".",
        "--limit",
        "5"
      ],
      "expect": "ok"
    },
    "query-no-graph": {
      "args": [
        "query",
        "callers_of",
        "x",
        "--repo",
        "{tmpdir}"
      ],
      "expect": "precondition"
    },
    "capabilities": {
      "args": [
        "capabilities"
      ],
      "expect": "ok"
    },
    "capabilities-detail": {
      "args": [
        "capabilities",
        "--command",
        "query"
      ],
      "expect": "ok"
    },
    "capabilities-unknown": {
      "args": [
        "capabilities",
        "--command",
        "nope"
      ],
      "expect": "usage"
    },
    "review-summary": {
      "args": [
        "review-summary",
        "--repo",
        "."
      ],
      "expect": "ok"
    },
    "review-context": {
      "args": [
        "review-context",
        "--repo",
        ".",
        "--limit",
        "3"
      ],
      "expect": "ok"
    },
    "review-context-no-graph": {
      "args": [
        "review-context",
        "--repo",
        "{tmpdir}"
      ],
      "expect": "precondition"
    },
    "search": {
      "args": [
        "search",
        "token budget",
        "--repo",
        ".",
        "--limit",
        "5"
      ],
      "expect": "ok"
    },
    "review-context-budget": {
      "args": [
        "review-context",
        "--repo",
        ".",
        "--files",
        "engine/code_review_graph/cli.py",
        "--limit",
        "5"
      ],
      "expect": "ok",
      "budget": 800,
      "expect_truncated": true,
      "expect_floor": "summary"
    },
    "review-context-budget-floor": {
      "args": [
        "review-context",
        "--repo",
        ".",
        "--files",
        "engine/code_review_graph/cli.py",
        "--limit",
        "5"
      ],
      "expect": "ok",
      "budget": 50,
      "expect_truncated": true,
      "expect_floor": "summary"
    },
    "review-summary-budget-ample": {
      "args": [
        "review-summary",
        "--repo",
        "."
      ],
      "expect": "ok",
      "budget": 20000
    },
    "query-budget": {
      "args": [
        "query",
        "callers_of",
        "attach_context_savings",
        "--repo",
        ".",
        "--limit",
        "10"
      ],
      "expect": "ok",
      "budget": 500,
      "expect_truncated": true
    },
    "capabilities-budget": {
      "args": [
        "capabilities"
      ],
      "expect": "ok",
      "budget": 600,
      "expect_truncated": true
    }
  }
}
