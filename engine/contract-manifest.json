{
  "name": "engine",
  "command": [
    ".venv/bin/python",
    "-m",
    "cartograph"
  ],
  "cwd": "engine",
  "operations": {
    "status": {
      "args": [
        "status",
        "--repo",
        "."
      ],
      "expect": "ok"
    },
    "status-no-graph": {
      "args": [
        "status",
        "--repo",
        "{tmpdir}"
      ],
      "expect": "precondition"
    },
    "query-hit": {
      "args": [
        "query",
        "callers_of",
        "attach_context_savings",
        "--repo",
        ".",
        "--limit",
        "3"
      ],
      "expect": "ok"
    },
    "query-miss": {
      "args": [
        "query",
        "callers_of",
        "definitely_not_a_real_symbol_xyz",
        "--repo",
        "."
      ],
      "expect": "ok"
    },
    "query-new-pattern": {
      "args": [
        "query",
        "references_to",
        "GraphStore",
        "--repo",
        ".",
        "--limit",
        "5"
      ],
      "expect": "ok"
    },
    "query-no-graph": {
      "args": [
        "query",
        "callers_of",
        "x",
        "--repo",
        "{tmpdir}"
      ],
      "expect": "precondition"
    },
    "capabilities": {
      "args": [
        "capabilities"
      ],
      "expect": "ok"
    },
    "capabilities-detail": {
      "args": [
        "capabilities",
        "--command",
        "query"
      ],
      "expect": "ok"
    },
    "capabilities-unknown": {
      "args": [
        "capabilities",
        "--command",
        "nope"
      ],
      "expect": "usage"
    },
    "review-summary": {
      "args": [
        "review-summary",
        "--repo",
        "."
      ],
      "expect": "ok"
    },
    "review-context": {
      "args": [
        "review-context",
        "--repo",
        ".",
        "--limit",
        "3"
      ],
      "expect": "ok"
    },
    "review-context-no-graph": {
      "args": [
        "review-context",
        "--repo",
        "{tmpdir}"
      ],
      "expect": "precondition"
    },
    "search": {
      "args": [
        "search",
        "token budget",
        "--repo",
        ".",
        "--limit",
        "5"
      ],
      "expect": "ok"
    },
    "search-zero-results": {
      "args": [
        "search",
        "zzz_no_such_symbol_zzz",
        "--repo",
        ".",
        "--limit",
        "7"
      ],
      "expect": "ok",
      "expect_page": {
        "limit": 7,
        "has_more": false,
        "result_count": 0
      }
    },
    "usage-bad-flag-value": {
      "args": [
        "search",
        "alpha",
        "--repo",
        ".",
        "--limit",
        "0"
      ],
      "expect": "usage"
    },
    "usage-bad-positional-choice": {
      "args": [
        "query",
        "not_a_pattern",
        "foo",
        "--repo",
        "."
      ],
      "expect": "usage"
    },
    "detect-changes": {
      "args": [
        "detect-changes",
        "--repo",
        "."
      ],
      "expect": "ok",
      "expect_page": false
    },
    "dead-code": {
      "args": [
        "dead-code",
        "--repo",
        ".",
        "--limit",
        "5"
      ],
      "expect": "ok",
      "expect_page": {
        "limit": 5,
        "result_count": 5
      }
    },
    "dead-code-no-graph": {
      "args": [
        "dead-code",
        "--repo",
        "{tmpdir}"
      ],
      "expect": "precondition"
    },
    "refactor-suggest": {
      "args": [
        "refactor",
        "suggest",
        "--repo",
        ".",
        "--limit",
        "3"
      ],
      "expect": "ok",
      "expect_page": {
        "collection": "suggestions",
        "limit": 3,
        "result_count": 3
      }
    },
    "review-context-budget": {
      "args": [
        "review-context",
        "--repo",
        ".",
        "--files",
        "engine/cartograph/cli.py",
        "--limit",
        "5"
      ],
      "expect": "ok",
      "budget": 800,
      "expect_truncated": true,
      "expect_floor": "summary"
    },
    "review-context-budget-floor": {
      "args": [
        "review-context",
        "--repo",
        ".",
        "--files",
        "engine/cartograph/cli.py",
        "--limit",
        "5"
      ],
      "expect": "ok",
      "budget": 50,
      "expect_truncated": true,
      "expect_floor": "summary"
    },
    "review-summary-budget-ample": {
      "args": [
        "review-summary",
        "--repo",
        "."
      ],
      "expect": "ok",
      "budget": 20000
    },
    "query-budget": {
      "args": [
        "query",
        "callers_of",
        "attach_context_savings",
        "--repo",
        ".",
        "--limit",
        "10"
      ],
      "expect": "ok",
      "budget": 500,
      "expect_truncated": true
    },
    "capabilities-budget": {
      "args": [
        "capabilities"
      ],
      "expect": "ok",
      "budget": 600,
      "expect_truncated": true
    },
    "search-paged": {
      "args": [
        "search",
        "cli",
        "--repo",
        ".",
        "--limit",
        "5"
      ],
      "expect": "ok",
      "page_twice": true
    },
    "cursor-garbage": {
      "args": [
        "search",
        "cli",
        "--repo",
        ".",
        "--cursor",
        "not-a-real-cursor"
      ],
      "expect": "precondition"
    }
  }
}
